# The deck, full screen on the Pi's display from boot, no desktop.
[Unit]
Description=deck DJ player
After=systemd-user-sessions.service sound.target network-online.target
Wants=network-online.target
# The deck owns the screen: no login prompt on it.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=deck
SupplementaryGroups=audio video render input plugdev
EnvironmentFile=-/etc/deck/deck.env
# KMS/DRM straight to the display, no X or Wayland.
Environment=SDL_VIDEODRIVER=kmsdrm
# The display's VT, so the console doesn't draw over us.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Full clock speed: frequency scaling adds audio jitter.
ExecStartPre=+/bin/sh -c 'for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do echo performance > "$g"; done'
ExecStart=/opt/deck/bin/deck --fullscreen $DECK_ARGS
WorkingDirectory=/var/lib/deck
Restart=always
RestartSec=1
# The audio thread asks for SCHED_FIFO 80 and memory is locked: allow both.
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10

[Install]
WantedBy=multi-user.target
