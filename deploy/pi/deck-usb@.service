# Mount a USB stick read-only for the deck's browser, while it's plugged in.
# Started by 99-deck-usb.rules; stops (and unmounts) when the stick goes.
[Unit]
Description=deck: USB stick %I
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/deck/bin/deck-usb mount %I
ExecStop=/opt/deck/bin/deck-usb unmount %I
