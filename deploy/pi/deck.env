# Options for the deck service (see `deck --help` in the README).
# After editing: sudo systemctl restart deck

# The DAC hat's output, by part of its name. `journalctl -u deck` lists the
# outputs if this doesn't match one.
DECK_ARGS="--device hifiberry --buffer 128"

# With a controller mapped (deck --midi-learn /etc/deck/k3.toml):
# DECK_ARGS="--device hifiberry --buffer 128 --midi /etc/deck/k3.toml"
