# Options for the deck service (see `kdj --help` in the README).
# After editing: sudo systemctl restart kdj

# The DAC hat's output, by part of its name. `journalctl -u kdj` lists the
# outputs if this doesn't match one.
# The Xone:K3 mapping (factory map; see config/xone-k3.toml): the deck
# waits for a K3 and picks it up whenever it's plugged in. For another
# controller, map it with `kdj --midi-learn /etc/kdj/mine.toml` and point
# --midi there.
KDJ_ARGS="--device hifiberry --buffer 128 --midi /etc/kdj/xone-k3.toml"
